{
  "expo": {
    "name": "CampusLink",
    "slug": "campuslink",
    "version": "2.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4285F4"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "devTeam": "57658NFUM9"
        }
      ],
      "./plugins/fix-onesignal-appgroup.js",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.campuslink.com.campuslink",
          "enableGooglePay": false
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/snapkit-fix.js",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "darragh.CampusLink",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "snapchat",
          "bitmoji-sdk",
          "instagram-stories"
        ],
        "SCSDKClientId": "238ff824-004b-4df6-8a8d-ec8e067a5cf5",
        "SCSDKRedirectUrl": "campuslink://snapkit/oauth2",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "campuslink"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "CampusLink uses your location to show nearby campus listings and help you find items close to you."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "34",
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.darragh.buckley1812.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*",
      "assets/legal/*.pdf"
    ],
    "extra": {
      "eas": {
        "projectId": "b0d32018-e9db-4736-8c4f-2b28965d609f"
      }
    },
    "owner": "darragh.buckley1812"
  }
}
